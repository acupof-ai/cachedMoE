// Shared factual defaults for native and Python consumers. One literal per
// line; no expressions, aliases, preprocessor branches or generated copies.
// INTEGER supports uint32_t/uint64_t, REAL is double, TEXT is printable ASCII
// with only quote/backslash escapes. tools/runtime_facts.py validates this
// grammar without evaluating code.

CACHEDMOE_RUNTIME_FACT_TEXT(MODEL_NAME, "DeepSeek-V4.1-Flash")
CACHEDMOE_RUNTIME_FACT_INTEGER(uint32_t, MAX_CONTEXT, 1048576)
CACHEDMOE_RUNTIME_FACT_INTEGER(uint32_t, DRAFT_BLOCK_SIZE, 5)
CACHEDMOE_RUNTIME_FACT_INTEGER(uint32_t, ACCEPT_TOP_K, 4)

// These context/token defaults have distinct callers and purposes.
CACHEDMOE_RUNTIME_FACT_INTEGER(uint32_t, SESSION_CONTEXT, 4096)
CACHEDMOE_RUNTIME_FACT_INTEGER(uint32_t, RUNTIME_CONTEXT, 65536)
CACHEDMOE_RUNTIME_FACT_INTEGER(uint32_t, NATIVE_MAX_TOKENS, 256)
CACHEDMOE_RUNTIME_FACT_INTEGER(uint32_t, WEB_MAX_TOKENS, 1024)

// Chat/request sampling; native greedy sampling keeps its separate defaults.
CACHEDMOE_RUNTIME_FACT_REAL(SAMPLING_TEMPERATURE, 1.0)
CACHEDMOE_RUNTIME_FACT_REAL(TOP_P, 0.95)

// Disk queue and parked-session capacity are separate semantic budgets.
CACHEDMOE_RUNTIME_FACT_INTEGER(uint64_t, KV_DISK_BYTES, 4294967296)
CACHEDMOE_RUNTIME_FACT_INTEGER(uint64_t, PARKED_KV_BYTES, 4294967296)
