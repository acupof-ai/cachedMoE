{
  "cwd": "/home/chenkailun/projects/cachedMoE",
  "jobs": [
    {
      "name": "wrap_selected",
      "command": [
        "build/tests/deepmoe_tests",
        "gpu_dspark.committed_prefix_survives_window_wrap"
      ],
      "timeout_s": 180
    },
    {
      "name": "adaptive_zero",
      "command": [
        "build/tests/deepmoe_tests",
        "gpu_dspark.adaptive_zero_keeps_one_target_forward"
      ],
      "timeout_s": 120
    },
    {
      "name": "l3_off",
      "command": [
        "/usr/bin/python",
        "tools/l3_ppl.py",
        "--state",
        "traces/l3_64",
        "--steps",
        "64",
        "--modes",
        "off",
        "--json",
        "bench/results/engram_deadline/guarded_gate/l3_off.json",
        "--log-dir",
        "bench/results/engram_deadline/guarded_gate/l3_logs"
      ],
      "timeout_s": 240,
      "env": {
        "DEEPMOE_MGT_ATTN_CM": "0"
      }
    },
    {
      "name": "mmlu6_baseline",
      "command": [
        "/usr/bin/python",
        "tools/mmlu_bench.py",
        "--sample",
        "bench/results/miss_mask/mmlu_sample.json",
        "--out",
        "bench/results/engram_deadline/guarded_gate/mmlu6_baseline",
        "--modes",
        "mask-spec",
        "--generation",
        "--limit",
        "6",
        "--max-tokens",
        "16",
        "--cache-slots",
        "5500",
        "--require-sources",
        "1"
      ],
      "timeout_s": 240,
      "env": {
        "DEEPMOE_IO_ENGRAM_DEADLINE": "0"
      }
    },
    {
      "name": "mmlu6_fix",
      "command": [
        "/usr/bin/python",
        "tools/mmlu_bench.py",
        "--sample",
        "bench/results/miss_mask/mmlu_sample.json",
        "--out",
        "bench/results/engram_deadline/guarded_gate/mmlu6_fix",
        "--modes",
        "mask-spec",
        "--generation",
        "--limit",
        "6",
        "--max-tokens",
        "16",
        "--cache-slots",
        "5500",
        "--require-sources",
        "1"
      ],
      "timeout_s": 240,
      "env": {}
    }
  ]
}
